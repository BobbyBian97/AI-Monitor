<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 通知栏自定义布局样式 (notif_balance.xml) -->
    <style name="NFRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <style name="NFRowLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="NFName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="NFVal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <!-- 等宽数字: 金额纵向对齐; 颜色由代码按主题/状态设置 -->
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="NFBar" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:progressTint">?android:attr/colorAccent</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- 桌面小部件布局样式 (widget_balance.xml): 显式配色, 亮暗由 values-night 切换 -->
    <style name="WGRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">1dp</item>
    </style>

    <style name="WGRowLine">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="WGName">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <style name="WGVal">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <!-- 等宽数字: 金额纵向对齐; 颜色由代码按皮肤/警示状态设置 -->
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/widget_text_primary</item>
    </style>

    <style name="WGBar" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:progressTint">@color/widget_bar_accent</item>
        <item name="android:visibility">gone</item>
    </style>
</resources>
